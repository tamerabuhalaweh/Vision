# Example environment file — copy locally as .env and fill values; NEVER commit .env
# This file documents variable NAMES only.
HF_TOKEN=            # huggingface.co token from local private file, used in memory only
HF_REPO_ID=          # e.g. TamerITIS/vision-social-video-20261017-<run-id> (private)
RUN_ID=              # unique immutable run slug used in all checkpoint paths
DATA_ROOT=           # server mount point for the cleared training data
CACHE_ROOT=          # server mount point for HF cache / latents / checkpoints
UPLOAD_INTERVAL_MINUTES=30
